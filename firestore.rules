rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'owner' ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['owner', 'admin', 'super_admin'] ||
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.isOwner == true ||
          (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.roles != null &&
           get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.roles.hasAny(['owner', 'admin', 'super_admin']))))
      );
    }

    function isNotBlocked(targetUserId) {
      return !exists(/databases/$(database)/documents/blocks/$(targetUserId + '_' + request.auth.uid));
    }

    function isFollower(targetUserId) {
      return exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + targetUserId)) &&
        get(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + targetUserId)).data.status == 'active';
    }

    function isCallParticipant(callId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/call_sessions/$(callId)) &&
        request.auth.uid in get(/databases/$(database)/documents/call_sessions/$(callId)).data.participantIds;
    }

    // ── Profiles: Anyone can read, only owner or admin can write ────────────────
    match /profiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && (
        !request.resource.data.keys().hasAny(['roles', 'role', 'isAdmin', 'isOwner', 'isBanned']) || isAdmin()
      );
      allow update: if (isOwner(userId) || isAdmin()) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'role', 'isAdmin', 'isOwner', 'isBanned', 'verificationStatus', 'verification_status']) || isAdmin()
      );
      allow delete: if isOwner(userId) || isAdmin();

      // ── Device Tokens: Owner-only (FCM push tokens) ────────────────────────
      // Only the owning user can read/write/delete their own FCM device tokens.
      // No other authenticated user can access another user's device tokens.
      match /device_tokens/{tokenId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    // ── Wallets: Owner read-only; financial balance mutations strictly server-only ──
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Clients can never create or delete wallet documents
      allow create, delete: if false;
      // Clients can only update non-financial payout settings (upiVpa, bankDetails);
      // All financial balance mutations are strictly blocked and restricted to server-side Admin SDK.
      allow update: if (isOwner(userId) || isAdmin()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'availableEarnings',
          'pendingEarnings',
          'lifetimeEarnings',
          'revSharePercentage',
          'currency',
          'balance',
          'coins'
        ]);
    }

    // ── Coin Wallets: Owner read-only; mutations strictly server-only ────────
    match /coin_wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ── Wallet Ledger: Immutable double-entry audit log (server-only write) ──
    match /wallet_ledger/{ledgerId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // ── Posts: Public posts readable by all ──────────────────────────────────
    match /posts/{postId} {
      allow read: if resource.data.privacy == 'public'
        || (isAuthenticated() && (resource.data.creatorId == request.auth.uid || resource.data.creator_id == request.auth.uid))
        || (isAuthenticated() && isFollower(resource.data.creatorId != null ? resource.data.creatorId : resource.data.creator_id));
      allow create: if isAuthenticated() && (request.resource.data.creatorId == request.auth.uid || request.resource.data.creator_id == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || resource.data.creator_id == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || resource.data.creator_id == request.auth.uid || isAdmin());
    }

    // ── Comments: Publicly viewable, author-only write ───────────────────────
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ── Likes: Owner-only private lists ─────────────────────────────────────
    match /likes/{likeId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ── Saves: Strict owner-only privacy ────────────────────────────────────
    match /saves/{saveId} {
      allow read, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
    }

    // ── Reposts: Publicly readable, owner-write ──────────────────────────────
    match /reposts/{repostId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ── Follows: Publicly readable graph, follower-only manipulation ─────────
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        (request.resource.data.followerId == request.auth.uid || request.resource.data.follower_id == request.auth.uid) &&
        isNotBlocked(request.resource.data.followingId != null ? request.resource.data.followingId : request.resource.data.following_id);
      allow update: if isAuthenticated() && (
        (resource.data.followingId == request.auth.uid || resource.data.following_id == request.auth.uid) || // Accept request
        (resource.data.followerId == request.auth.uid || resource.data.follower_id == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        (resource.data.followerId == request.auth.uid || resource.data.follower_id == request.auth.uid) ||
        (resource.data.followingId == request.auth.uid || resource.data.following_id == request.auth.uid) ||
        isAdmin()
      );
    }

    // ── Stories: 24h lifetime, audience check ───────────────────────────────
    match /stories/{storyId} {
      allow read: if resource.data.audience == 'everyone'
        || (isAuthenticated() && resource.data.creatorId == request.auth.uid)
        || (isAuthenticated() && isFollower(resource.data.creatorId));
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());
    }

    // ── Conversations: Participant-only access ───────────────────────────────
    match /conversations/{conversationId} {
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participantIds;
    }

    // ── Messages: Strict participant-only delivery, injection prevention, and viewing ───
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.sender_id == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.recipient_id == request.auth.uid ||
        (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds) ||
        (resource.data.participant_ids != null && request.auth.uid in resource.data.participant_ids)
      );
      allow create: if isAuthenticated() &&
        (request.resource.data.senderId == request.auth.uid || request.resource.data.sender_id == request.auth.uid) &&
        ((request.resource.data.participantIds != null && request.auth.uid in request.resource.data.participantIds) ||
         (request.resource.data.participant_ids != null && request.auth.uid in request.resource.data.participant_ids)) &&
        (
          // Direct message: explicit recipient, not sender, recipient not blocked, and recipient in participantIds
          (request.resource.data.recipientId != null &&
           request.resource.data.recipientId != request.auth.uid &&
           isNotBlocked(request.resource.data.recipientId) &&
           ((request.resource.data.participantIds != null && request.resource.data.recipientId in request.resource.data.participantIds) ||
            (request.resource.data.participant_ids != null && request.resource.data.recipientId in request.resource.data.participant_ids))) ||
          // Group message: recipientId may only be null if conversation exists, is group type, and sender is a verified member
          (request.resource.data.recipientId == null &&
           exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId != null ? request.resource.data.conversationId : request.resource.data.conversation_id)) &&
           get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId != null ? request.resource.data.conversationId : request.resource.data.conversation_id)).data.type == 'group' &&
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId != null ? request.resource.data.conversationId : request.resource.data.conversation_id)).data.participantIds)
        ) &&
        (!exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId != null ? request.resource.data.conversationId : request.resource.data.conversation_id)) ||
         request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId != null ? request.resource.data.conversationId : request.resource.data.conversation_id)).data.participantIds);
      allow update, delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.sender_id == request.auth.uid || isAdmin());
    }

    // ── Notifications: Recipient-only read/update ────────────────────────────
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && (
        resource.data.recipientId == request.auth.uid ||
        resource.data.recipient_id == request.auth.uid
      );
      // Create: only the system (Admin SDK) or the sender can create notifications.
      // Prohibits client-side creation of privileged system notification types,
      // self-notification injection, and notifications to users who have blocked the sender.
      allow create: if isAuthenticated() &&
        (request.resource.data.senderId == request.auth.uid || request.resource.data.sender_id == request.auth.uid) &&
        (request.resource.data.recipientId != request.auth.uid && request.resource.data.recipient_id != request.auth.uid) &&
        !(request.resource.data.type in ['security', 'system', 'announcement', 'monetization']) &&
        (request.resource.data.recipientId == null || isNotBlocked(request.resource.data.recipientId));
    }

    // ── Notification Preferences: Owner-only ────────────────────────────────
    // Users can only read/write their own notification preferences.
    // No user can modify another user's notification preferences.
    match /notification_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Hashtags: Taxonomy index readable by all ─────────────────────────────
    match /hashtags/{tag} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ── Blocks: Target isolation ─────────────────────────────────────────────
    match /blocks/{blockId} {
      allow read, write: if isAuthenticated() && (
        resource == null || resource.data.blockerId == request.auth.uid
      );
    }

    // ── Call Sessions: Participant-only signaling ────────────────────────────
    // SECURITY FIX: Replaced overly broad `isAuthenticated()` with strict
    // participant-only access. Only users listed in the session's participantIds
    // can read or write call sessions and their signals.
    // Arbitrary authenticated users cannot access another user's call session.
    match /call_sessions/{callId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid in resource.data.participantIds
      );
      allow create: if isAuthenticated() && (
        request.auth.uid in request.resource.data.participantIds
      );
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds || isAdmin()
      );

      // ── Call Signals (subcollection): Participant-only ───────────────────
      match /signals/{signalId} {
        allow read: if isCallParticipant(callId) || (isAuthenticated() && (
          resource == null ||
          resource.data.senderId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid ||
          (resource.data.message != null && (resource.data.message.senderId == request.auth.uid || resource.data.message.recipientId == request.auth.uid)) ||
          (exists(/databases/$(database)/documents/call_sessions/$(callId)) && request.auth.uid in get(/databases/$(database)/documents/call_sessions/$(callId)).data.participantIds)
        ));
        allow create: if isCallParticipant(callId) || (isAuthenticated() && (
          request.resource.data.senderId == request.auth.uid ||
          (request.resource.data.message != null && request.resource.data.message.senderId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/call_sessions/$(callId)) && request.auth.uid in get(/databases/$(database)/documents/call_sessions/$(callId)).data.participantIds)
        ));
        allow update, delete: if isCallParticipant(callId) || (isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid ||
          (exists(/databases/$(database)/documents/call_sessions/$(callId)) && request.auth.uid in get(/databases/$(database)/documents/call_sessions/$(callId)).data.participantIds) ||
          isAdmin()
        ));
      }
    }

    // ── Call Signals (top-level): Sender/recipient-only ─────────────────────
    match /call_signals/{signalId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.targetId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        (request.resource.data.senderId == request.auth.uid ||
         (request.resource.data.message != null && request.resource.data.message.senderId == request.auth.uid)) &&
        (request.resource.data.targetId == null || isNotBlocked(request.resource.data.targetId)) &&
        (request.resource.data.recipientId == null || isNotBlocked(request.resource.data.recipientId))
      );
      allow update: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.targetId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.targetId == request.auth.uid ||
        isAdmin()
      );
    }

    // ── User Interactions: Interaction events for ranking algorithms ─────────
    match /user_interactions/{interactionId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    // ── Feature Flags: Read-only for clients, managed by admins ─────────────
    match /feature_flags/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Reports: Any authenticated user can submit, only owner/admin can read/action ────────
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // ── Payouts: Creators can submit & read own, only owner/admin can approve/reject ────────
    match /payouts/{payoutId} {
      allow create: if isAuthenticated() && (
        request.resource.data.creatorId == request.auth.uid ||
        request.resource.data.creator_id == request.auth.uid
      );
      allow read: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.creator_id == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ── Admin Logs: Strict Owner / Admin immutable audit trail ─────────────
    match /admin_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    // ── Announcements: Publicly readable, owner/admin authored ──────────────
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Media Processing Jobs: Requester-only access (Duet/Stitch worker) ────
    match /media_jobs/{jobId} {
      allow read: if isAuthenticated() && (resource.data.requesterUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.status == 'queued' &&
        !request.resource.data.keys().hasAny(['outputMedia', 'workerInstanceId']);
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.requesterUid == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['requesterUid', 'sourcePostId', 'type', 'outputMedia', 'workerInstanceId']) &&
         request.resource.data.status in ['cancelled', 'failed'])
      );
      allow delete: if isAuthenticated() && (resource.data.requesterUid == request.auth.uid || isAdmin());
    }

    // ── Ad Impressions: Append-only viewer-attributed analytics (no forging, immutable) ──
    match /ad_impressions/{impressionId} {
      allow read: if isAuthenticated() && (
        resource.data.viewerId == request.auth.uid ||
        resource.data.viewer_id == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        resource.data.creator_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.viewerId == request.auth.uid ||
        request.resource.data.viewer_id == request.auth.uid
      );
      allow update, delete: if false; // Append-only analytics
    }

    // ── Ad Clicks: Append-only viewer-attributed click tracking (no forging, immutable) ──
    match /ad_clicks/{clickId} {
      allow read: if isAuthenticated() && (
        resource.data.viewerId == request.auth.uid ||
        resource.data.viewer_id == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        resource.data.creator_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.viewerId == request.auth.uid ||
        request.resource.data.viewer_id == request.auth.uid
      );
      allow update, delete: if false; // Append-only analytics
    }

    // ── Products: Public catalog, seller/creator ownership enforcement ──────
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.creatorId == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        ((resource.data.creatorId == request.auth.uid || resource.data.sellerId == request.auth.uid) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['creatorId', 'sellerId']) ||
          request.resource.data.creatorId == request.auth.uid ||
          request.resource.data.sellerId == request.auth.uid))
      );
      allow delete: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
    }

    // ── Orders: Buyer/seller isolated access, immutable financial totals ─────
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.buyer_id == request.auth.uid ||
        (resource.data.sellerIds != null && request.auth.uid in resource.data.sellerIds) ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid ||
        request.resource.data.buyer_id == request.auth.uid
      ) && !request.resource.data.keys().hasAny(['settlementAmount', 'settledAt', 'payoutStatus']);
      // Clients can never alter financial totals, commissions, payment methods, or ownership
      allow update: if isAuthenticated() && (
        isAdmin() ||
        // Buyer can update non-financial fields (e.g., returnReason)
        ((resource.data.buyerId == request.auth.uid || resource.data.buyer_id == request.auth.uid) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'totalAmountInr',
           'creatorCommissionInr',
           'paymentMethod',
           'buyerId',
           'buyer_id',
           'sellerIds',
           'sellerId',
           'creatorId',
           'settlementAmount',
           'payoutStatus'
         ])) ||
        // Seller can update fulfillment / tracking without altering financial totals
        (((resource.data.sellerIds != null && request.auth.uid in resource.data.sellerIds) ||
          resource.data.sellerId == request.auth.uid ||
          resource.data.creatorId == request.auth.uid) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'totalAmountInr',
           'creatorCommissionInr',
           'paymentMethod',
           'buyerId',
           'buyer_id',
           'settlementAmount',
           'payoutStatus'
         ]))
      );
      allow delete: if isAdmin(); // Orders are immutable records for audit trail

      // ── Order Items (subcollection): Buyer/seller access, immutable records ──
      match /order_items/{itemId} {
        allow read: if isAuthenticated() && (
          resource.data.buyerId == request.auth.uid ||
          resource.data.buyer_id == request.auth.uid ||
          resource.data.sellerId == request.auth.uid ||
          resource.data.creatorId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          request.resource.data.buyerId == request.auth.uid ||
          request.resource.data.buyer_id == request.auth.uid
        );
        allow update, delete: if isAdmin();
      }
    }

    // ── Order Items (top-level collection): Buyer/seller access, immutable records ──
    match /order_items/{itemId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.buyer_id == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid ||
        request.resource.data.buyer_id == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }
  }
}
